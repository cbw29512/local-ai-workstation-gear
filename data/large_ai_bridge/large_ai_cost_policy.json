  "future_api_mode_limits": {
    "daily_request_limit": 3,
    "monthly_request_limit": 50,
    "require_task_reason": true,
    "require_target_file": true,
    "require_expected_output_schema": true,
    "write_only_to_staging": true
  },
  "safety_locks": {
    "affiliate_link_changes_allowed": false,
    "product_swap_allowed": false,
    "git_commit_allowed": false,
    "git_push_allowed": false,
    "publish_allowed": false,
    "spending_allowed": false,
    "outreach_allowed": false
  },
  "next_required_gate": "manual_large_ai_handoff_only"
}
